# Copy this file to .env.local (it is git-ignored), fill it in, then restart `npm run dev`.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# --- Contact form (Resend) ---------------------------------------------------
# 1. Sign up at https://resend.com with spandansahu07@gmail.com (the free plan is enough)
# 2. API Keys → Create API Key → paste it here
RESEND_API_KEY=
# Where enquiries are delivered
CONTACT_TO_EMAIL=spandansahu07@gmail.com
# Leave as-is to start. The shared sender below can ONLY deliver to the email you signed up to
# Resend with. To send to any inbox, verify your own domain in Resend and use e.g.
# "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Client reviews storage (optional, needed on Vercel) ---------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
